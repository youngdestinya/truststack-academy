{
  "framework": "nextjs",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "devCommand": "next dev",
  "redirects": [
    {
      "source": "/courses-tracks.html",
      "destination": "/courses",
      "permanent": true
    },
    {
      "source": "/courses-tracks",
      "destination": "/courses",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/site-navigation.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
